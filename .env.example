# Application
APP_NAME="Open Graph Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://og.test
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# File-backed sessions and cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# Application logs
LOG_CHANNEL=single
LOG_LEVEL=debug

# URL checks: enable private targets only on a trusted local installation
PREVIEW_ALLOW_PRIVATE_TARGETS=true

# Optional Twitter/X account names, including @
SOCIAL_TWITTER_SITE=
SOCIAL_TWITTER_CREATOR=

# Optional Sentry monitoring
MONITORING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=opengraph-works@1.0.0

# Optional Matomo analytics (requires visitor consent)
MATOMO_ENABLED=false
MATOMO_URL=
MATOMO_SITE_ID=12

# Actual hosting and retention settings for the privacy notice
LEGAL_HOSTING_LOCATION=
LEGAL_WEB_LOGS_DAYS=7
LEGAL_MATOMO_DAYS=180
LEGAL_SENTRY_DAYS=30

# Optional Google Search Console / Bing Webmaster verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional footer credits. Empty owner/hosting names hide their line.
FOOTER_OWNER_NAME=
FOOTER_OWNER_URL=
FOOTER_HOSTING_NAME=
FOOTER_HOSTING_URL=

# Backend database: SQLite or your configured MySQL/PostgreSQL database
DB_CONNECTION=sqlite
